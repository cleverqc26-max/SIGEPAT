# Copia este archivo como ".env" y ajusta los valores segun tu instalacion de XAMPP.
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-propia
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Datos de conexion a MySQL (XAMPP trae por defecto usuario "root" sin contrasena)
DB_NAME=sigepat_bd
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
